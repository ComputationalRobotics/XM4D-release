# --- Data and results: never commit ---
# datasets/ holds the preprocessed inputs (downloaded separately, see datasets/README.md); only its README is tracked
datasets/*
!datasets/README.md
results/

# --- Run logs & Python caches ---
*.log
Python/logs/
__pycache__/
*.pyc
*.pyo

# --- Large binary / data artifacts (safety net) ---
*.npz
*.npy
*.bin
*.mp4
*.avi
*.ply
*.pt
*.pth
*.ckpt
*.zip
*.tar
*.tar.gz
*.pkl
*.mat
*.png
*.jpg
*.jpeg
*.h5

# XM/build/ holds CMake build files when XM is built from source; keep only our compiled binding (.so)
XM/build/*
!XM/build/*.so

# build/gsplat_examples: generated by scripts/setup_gsplat.sh
/build/
