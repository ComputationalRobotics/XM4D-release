# --- Data: never commit (except the example scenes, see the end) ---
datasets/*
!datasets/sintel_alley_2/
!datasets/hoi_ip1073/
# gsplat example data (360_v2 datasets, images, COLMAP .bin) — ~13 GB, not code
deps/
# the 4D Gaussian trainer, assembled by install/gs.sh from deps/gsplat + gsplat_patch/
build/

# --- Run logs & Python caches ---
*.log
Python/logs/
__pycache__/
*.pyc
*.pyo

# --- Large binary / data artifacts (safety net) ---
*.npz
*.npy
*.bin
*.mp4
*.avi
*.ply
*.pt
*.pth
*.ckpt
*.zip
*.tar
*.tar.gz
*.pkl
*.mat
*.png
*.jpg
*.jpeg
*.h5

# keep the prebuilt XM solver (.so) — the Python imports it; source is in the XM-code repo
!XM/build/*.so

# the example scenes ship with the repo (frames + masks), not their pipeline outputs
!datasets/sintel_alley_2/**
datasets/sintel_alley_2/outputs/
!datasets/hoi_ip1073/**
datasets/hoi_ip1073/outputs/
