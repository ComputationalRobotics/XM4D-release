# --- Data: never commit (except the example scenes, see the end) ---
datasets/*
!datasets/sintel_alley_2/
# third-party code and models, installed by install/*.sh
deps/
# GLOMAP and COLMAP, built by install/glomap.sh
build/

# --- Run logs & Python caches ---
*.log
Python/logs/
__pycache__/
*.pyc
*.pyo

# --- Large binary / data artifacts (safety net) ---
*.npz
*.npy
*.bin
*.mp4
*.avi
*.ply
*.pt
*.pth
*.ckpt
*.zip
*.tar
*.tar.gz
*.pkl
*.mat
*.png
*.jpg
*.jpeg
*.h5

# keep the prebuilt XM solver (.so) — the Python imports it; its source is XM/
!XM/build/*.so
# the data of examples/
!examples/data/**

# the example scenes ship with the repo (frames + masks), not their pipeline outputs
!datasets/sintel_alley_2/**
datasets/sintel_alley_2/outputs/
